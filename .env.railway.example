# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Supabase Postgres
# Use the Supavisor SESSION pooler connection string on port 5432 for Railway.
# Pin the dedicated Dabdoob project ref so a DATABASE_URL from another Supabase project fails closed.
SUPABASE_PROJECT_REF=PROJECT_REF
DATABASE_URL=postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&pool_timeout=20
READINESS_DATABASE_TIMEOUT_MS=5000

# Required application security
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Public URLs - replace after Railway generates the service domain
APP_URL=https://YOUR-SERVICE.up.railway.app
FRONTEND_URL=https://datauplode.vercel.app
CORS_ORIGINS=https://datauplode.vercel.app,https://YOUR-SERVICE.up.railway.app
VITE_API_BASE_URL=https://YOUR-SERVICE.up.railway.app

# Shopify
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SHOP_DOMAIN=YOUR-STORE.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_DEFAULT_IN_STOCK_QUANTITY=10

# Google Sheet
CATALOG_AUDIT_SHEET_URL=https://docs.google.com/spreadsheets/d/1fCbPajWL3nukX0TdoN1m2X8LV3pfPsxSMLBb0yWug2w/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
GOOGLE_SHEET_AUTO_SYNC_DEFAULT_INTERVAL_SECONDS=1800
GOOGLE_SHEET_PROCESSED_ROWS_TTL_HOURS=720

# Production write gates: keep every gate closed for the first deployment.
SYNC_RUNTIME_WRITE_ENABLED=false
SYNC_FIRST5_RECONCILE_ENABLED=false
SYNC_PRICING_RULE_SEED_ENABLED=false
SYNC_INVENTORY_AUTOSTART=false
SYNC_JOB_RECOVERY_ENABLED=false
# Second gate: recovered publish/republish/sync jobs can mutate Shopify, so keep it closed independently.
SYNC_JOB_RECOVERY_SHOPIFY_WRITES_ENABLED=false
SYNC_SHEET_IMPORT_AUTOSTART_ENABLED=false
CATALOG_AUDIT_DRY_RUN=true
CATALOG_AUDIT_WRITE_ENABLED=false
CATALOG_AUDIT_WRITE_TOKEN=
CATALOG_AUDIT_CANARY_MAX_ROWS=1
CATALOG_AUDIT_SHEET_WRITE_ENABLED=false

# Reliable inventory jobs - these settings take effect only after runtime writes are enabled.
SYNC_INVENTORY_INTERVAL_MINUTES=30
SYNC_INVENTORY_BATCH_SIZE=25
SYNC_INVENTORY_MIN_AGE_MINUTES=30
SYNC_FULL_SOURCE_REFRESH=true
SYNC_REBUILD_ON_VARIANT_CHANGE=true
SYNC_JOB_WAIT_TIMEOUT_MS=900000
SYNC_JOB_RECOVERY_LIMIT=50
SYNC_JOB_STALE_RUNNING_MINUTES=10

# Scraper defaults
SCRAPER_LOG_LEVEL=info
SCRAPER_WORKER_CONCURRENCY=2
SCRAPER_LOCAL_ONLY_MODE=false
SCRAPER_READER_FALLBACK=true
NEXT_SITE_API_ENABLED=true
SCRAPER_RESULT_CACHE_MINUTES=60

# Optional Redis. Leave blank until a Redis service is added.
REDIS_URL=
