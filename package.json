{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --watch-path=server.ts --watch-path=src/server --import tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "env:check": "tsx scripts/check-env.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test:scraper": "tsx test-scraper.ts",
    "test:scraper:urls": "tsx test-user-urls.ts",
    "test:scraper:next": "tsx test-next-scraper-details.ts",
    "test:scraper:regression": "tsx test-scraper-regression.ts",
    "test:scraper:all": "npm run test:scraper:urls && npm run test:scraper:regression",
    "test:scraper:demo": "tsx test-scraper-demo.ts",
    "test:brand-matrix": "tsx test-brand-matrix-professional.ts",
    "test:extraction-engine": "tsx test-extraction-engine.ts",
    "test:brand-limits": "tsx test-brand-limits.ts",
    "test:source-scan": "tsx test-source-capability-scanner.ts",
    "bridge:worker": "tsx scripts/local-bridge-worker.ts",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push",
    "db:studio": "prisma studio",
    "railway:deploy": "npm run db:deploy && npm start"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "bullmq": "^5.76.8",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "crawlee": "^3.16.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "p-queue": "^8.0.1",
    "pino": "^10.3.1",
    "playwright": "^1.60.0",
    "prisma": "^6.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^6.30.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
