# ==========================================
# Dabdoob Product Sync Production Environment (Railway)
# Safe-mode first deployment: keep all write paths closed until CI, Dry Run,
# one-product Canary, and Shopify read-back have succeeded.
# ==========================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Supabase Postgres
# Use the Supavisor SESSION pooler on port 5432 for a long-running Railway service.
# Do not use the transaction pooler on port 6543 for Prisma runtime traffic.
# Pin the dedicated Dabdoob project ref; preflight rejects a DATABASE_URL for any other Supabase project.
# Supabase pooler usernames normally use postgres.PROJECT_REF.
# URL-encode special characters in the database password (for example @ becomes %40).
SUPABASE_PROJECT_REF=PROJECT_REF
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&pool_timeout=20
READINESS_DATABASE_TIMEOUT_MS=5000

# Required core
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_URL=https://YOUR-RAILWAY-BACKEND.up.railway.app
# The Node server serves the built frontend too, so a single Railway origin is supported.
FRONTEND_URL=https://YOUR-RAILWAY-BACKEND.up.railway.app
CORS_ORIGINS=https://YOUR-RAILWAY-BACKEND.up.railway.app
# Leave blank for same-origin /api requests when frontend and backend are served by Railway together.
VITE_API_BASE_URL=

# Shopify
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_DEFAULT_IN_STOCK_QUANTITY=10

# Production write gates — keep explicitly closed for the first deployment.
SYNC_RUNTIME_WRITE_ENABLED=false
SYNC_FIRST5_RECONCILE_ENABLED=false
SYNC_PRICING_RULE_SEED_ENABLED=false
SYNC_INVENTORY_AUTOSTART=false
SYNC_JOB_RECOVERY_ENABLED=false
# Second gate: required even after runtime writes are enabled because recovered jobs can mutate Shopify.
SYNC_JOB_RECOVERY_SHOPIFY_WRITES_ENABLED=false
SYNC_SHEET_IMPORT_AUTOSTART_ENABLED=false
CATALOG_AUDIT_DRY_RUN=true
CATALOG_AUDIT_WRITE_ENABLED=false
CATALOG_AUDIT_WRITE_TOKEN=
CATALOG_AUDIT_CANARY_MAX_ROWS=1
CATALOG_AUDIT_SHEET_WRITE_ENABLED=false

# Inventory/recovery settings — inert while runtime writes remain disabled.
SYNC_INVENTORY_INTERVAL_MINUTES=30
SYNC_INVENTORY_BATCH_SIZE=25
SYNC_INVENTORY_MIN_AGE_MINUTES=30
SYNC_FULL_SOURCE_REFRESH=true
SYNC_REBUILD_ON_VARIANT_CHANGE=true
SYNC_JOB_WAIT_TIMEOUT_MS=900000
SYNC_JOB_RECOVERY_LIMIT=50
SYNC_JOB_STALE_RUNNING_MINUTES=10

# Google Sheet
CATALOG_AUDIT_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
GOOGLE_SHEET_AUTO_SYNC_DEFAULT_INTERVAL_SECONDS=1800
GOOGLE_SHEET_PROCESSED_ROWS_TTL_HOURS=720

# Recommended for stable server behavior
SCRAPER_LOCAL_ONLY_MODE=false
SCRAPER_READER_FALLBACK=true
NEXT_SITE_API_ENABLED=true
SCRAPER_BYPASS_MODE=never
SCRAPER_BYPASS_PROVIDERS=scraperapi,zenrows
SCRAPER_BYPASS_DAILY_LIMIT=0
SCRAPER_BYPASS_COOLDOWN_MINUTES=15

# Optional paid providers
SCRAPERAPI_KEY=
SCRAPERAPI_RENDER=true
SCRAPERAPI_PREMIUM=true
SCRAPERAPI_COUNTRY_CODE=ae
SCRAPERAPI_DEVICE_TYPE=mobile

ZENROWS_API_KEY=
ZENROWS_JS_RENDER=true
ZENROWS_PREMIUM_PROXY=true
ZENROWS_PROXY_COUNTRY=ae

# Optional integrations
REDIS_URL=
GEMINI_API_KEY=
