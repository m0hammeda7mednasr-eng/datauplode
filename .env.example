# ==========================================
# Syncly Local Environment (Development)
# ==========================================

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DISABLE_HMR=false

# Database (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Security (required in production, recommended in all environments)
ENCRYPTION_KEY=replace-with-a-long-random-secret-key

# Public URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Shopify
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_DEFAULT_IN_STOCK_QUANTITY=10

# Inventory sync
SYNC_INVENTORY_AUTOSTART=true
SYNC_INVENTORY_INTERVAL_MINUTES=30
SYNC_INVENTORY_BATCH_SIZE=25
SYNC_INVENTORY_MIN_AGE_MINUTES=30
SYNC_FULL_SOURCE_REFRESH=true
SYNC_REBUILD_ON_VARIANT_CHANGE=true
SYNC_JOB_WAIT_TIMEOUT_MS=900000
SYNC_JOB_RECOVERY_ENABLED=true
SYNC_JOB_RECOVERY_LIMIT=50
SYNC_JOB_STALE_RUNNING_MINUTES=10

# Google Sheet auto sync
GOOGLE_SHEET_AUTO_SYNC_DEFAULT_INTERVAL_SECONDS=1800
GOOGLE_SHEET_PROCESSED_ROWS_TTL_HOURS=720

# Core scraper behavior
SCRAPER_LOG_LEVEL=info
SCRAPER_WORKER_CONCURRENCY=2
SCRAPER_LOCAL_ONLY_MODE=false
SCRAPER_READER_FALLBACK=true
NEXT_SITE_API_ENABLED=true
SCRAPER_RESULT_CACHE_MINUTES=60

# Analyze/prewarm cache
SCRAPE_ANALYZE_CACHE_HOURS=168
SCRAPE_ANALYZE_PERSISTENT_CACHE=true
SCRAPE_ANALYZE_CACHE_FILE=.syncly-cache/analyze-products.json
ANALYZE_PREWARM_ENABLED=true
ANALYZE_PREWARM_WAIT_MS=2500
NEXT_LISTING_CACHE_MINUTES=60
NEXT_LISTING_PERSISTENT_CACHE=true
NEXT_LISTING_CACHE_FILE=.syncly-cache/next-listings.json

# Bypass router
SCRAPER_BYPASS_MODE=never
SCRAPER_BYPASS_PROVIDERS=scraperapi,zenrows,scrapingbee,scrapingant,scrapedo
SCRAPER_BYPASS_DAILY_LIMIT=0
SCRAPER_BYPASS_COOLDOWN_MINUTES=15
SCRAPER_BYPASS_PROVIDER_COOLDOWN_MINUTES=30
SCRAPER_BYPASS_RACE_MAX_PROVIDERS=2
SCRAPER_BYPASS_RACE_TIMEOUT_MS=12000
SCRAPER_BRAND_BYPASS_MODE_MAP=default:auto,next:auto,max_fashion:auto
SCRAPER_BYPASS_PROVIDER_MONTHLY_LIMITS=scraperapi:50000,zenrows:30000,scrapingbee:20000,scrapingant:20000,scrapedo:20000

# Provider credentials (optional, paid providers)
SCRAPERAPI_KEY=
SCRAPERAPI_RENDER=true
SCRAPERAPI_PREMIUM=true
SCRAPERAPI_ULTRA_PREMIUM=false
SCRAPERAPI_COUNTRY_CODE=ae
SCRAPERAPI_DEVICE_TYPE=mobile

ZENROWS_API_KEY=
ZENROWS_JS_RENDER=true
ZENROWS_PREMIUM_PROXY=true
ZENROWS_PROXY_COUNTRY=ae
ZENROWS_CUSTOM_HEADERS=false

SCRAPINGBEE_API_KEY=
SCRAPINGBEE_RENDER_JS=true
SCRAPINGBEE_PREMIUM_PROXY=true
SCRAPINGBEE_COUNTRY_CODE=ae

SCRAPINGANT_API_KEY=

SCRAPEDO_TOKEN=
SCRAPEDO_RENDER=true
SCRAPEDO_SUPER_PROXY=true
SCRAPEDO_GEO_CODE=ae

# Brand fast-path tuning
NEXT_API_TIMEOUT_MS=3000
NEXT_HTML_TIMEOUT_MS=7000
NEXT_HTML_RETRIES=1
NEXT_FAST_BYPASS=true
NEXT_FAST_BYPASS_URLS=1
NEXT_FAST_BYPASS_DEVICE=mobile
NEXT_FAST_BYPASS_PREMIUM=false
NEXT_FAST_BYPASS_RACE=true
NEXT_FAST_BYPASS_RACE_MAX_PROVIDERS=2
NEXT_FAST_BYPASS_RACE_TIMEOUT_MS=12000
NEXT_BYPASS_DEVICE=mobile
NEXT_BYPASS_PREMIUM=false
NEXT_BYPASS_RACE=true
NEXT_BYPASS_RACE_MAX_PROVIDERS=2
NEXT_BYPASS_RACE_TIMEOUT_MS=12000
NEXT_LISTING_FAST_BYPASS=true
NEXT_LISTING_PREMIUM=false
NEXT_LISTING_BYPASS_RACE=true
NEXT_LISTING_RACE_MAX_PROVIDERS=2
NEXT_LISTING_RACE_TIMEOUT_MS=12000
MAX_FASHION_TIMEOUT_MS=12000
MAX_FASHION_FAST_PLAYWRIGHT=true

# Optional integrations
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=

# Local Worker Bridge (free fallback for server-blocked product pages)
LOCAL_BRIDGE_ENABLED=true
LOCAL_BRIDGE_REQUIRE_TOKEN=true
LOCAL_BRIDGE_TOKEN=
LOCAL_BRIDGE_API_BASE_URL=http://localhost:3000/api
LOCAL_BRIDGE_POLL_MS=2500
LOCAL_BRIDGE_TASK_TTL_MINUTES=60
LOCAL_BRIDGE_RECLAIM_MINUTES=5
LOCAL_BRIDGE_NAV_TIMEOUT_MS=30000
LOCAL_BRIDGE_CAPTURE_WAIT_MS=1200
LOCAL_BRIDGE_MAX_TEXT_CHARS=180000
LOCAL_BRIDGE_HEADLESS=true
LOCAL_BRIDGE_ALLOW_INTERACTIVE_SOLVE=true
LOCAL_BRIDGE_INTERACTIVE_WAIT_MS=90000
LOCAL_BRIDGE_INTERACTIVE_POLL_MS=5000
LOCAL_BRIDGE_PROMPT_ON_BLOCKED=true
