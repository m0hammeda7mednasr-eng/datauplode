# Local development
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# Supabase PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Public URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://datauplode.vercel.app"

# Vite browser bundle. For Vercel, set this to the Railway backend URL.
VITE_API_BASE_URL="http://localhost:3000"

# Shopify OAuth
SHOPIFY_API_VERSION="2026-04"
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_ACCESS_TOKEN=""

# 32-byte encryption key for stored Shopify secrets/tokens.
ENCRYPTION_KEY="replace-with-a-32-byte-secret-key!"

# Optional AI/scraper helpers
GEMINI_API_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
