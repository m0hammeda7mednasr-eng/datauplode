# Local development
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# Supabase PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Public URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://datauplode.vercel.app"

# Vite browser bundle. For Vercel, set this to the Railway backend URL.
VITE_API_BASE_URL="http://localhost:3000"

# Shopify OAuth
SHOPIFY_API_VERSION="2026-04"
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_DEFAULT_IN_STOCK_QUANTITY="10"
SYNC_INVENTORY_AUTOSTART="true"
SYNC_INVENTORY_INTERVAL_MINUTES="15"
SYNC_INVENTORY_BATCH_SIZE="25"
SYNC_INVENTORY_MIN_AGE_MINUTES="1440"

# 32-byte encryption key for stored Shopify secrets/tokens.
ENCRYPTION_KEY="replace-with-a-32-byte-secret-key!"

# Optional AI/scraper helpers
GEMINI_API_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
REDIS_URL="redis://localhost:6379"
SCRAPER_LOG_LEVEL="info"
SCRAPER_WORKER_CONCURRENCY="2"

# Legacy managed bypass settings are kept only for old deployments and are disabled in code.
SCRAPER_BYPASS_PROVIDERS=""
SCRAPER_BYPASS_MODE="never"
SCRAPER_BYPASS_DAILY_LIMIT="0"
SCRAPER_BYPASS_COOLDOWN_MINUTES="120"
SCRAPE_ANALYZE_CACHE_HOURS="168"

# ScraperAPI (recommended on Vercel/Railway)
SCRAPERAPI_KEY=""
SCRAPERAPI_RENDER="false"
SCRAPERAPI_COUNTRY_CODE="ae"
SCRAPERAPI_DEVICE_TYPE="mobile"
SCRAPERAPI_PREMIUM="false"
SCRAPERAPI_ULTRA_PREMIUM="false"

# ZenRows (optional secondary provider)
ZENROWS_API_KEY=""
ZENROWS_JS_RENDER="false"
ZENROWS_PREMIUM_PROXY="true"
ZENROWS_PROXY_COUNTRY="ae"
ZENROWS_CUSTOM_HEADERS="false"
