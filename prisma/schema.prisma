// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUrl     String
  type        String   @default("generic") // generic, zara, shein, hm
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    SourceProduct[]
}

model Source {
  id                  String             @id @default(cuid())
  name                String
  baseUrl             String
  domain              String             @unique
  type                String
  mode                String             @default("auto")
  status              String             @default("READY")
  rateLimitJson       String?
  customSelectorsJson String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  extractedProducts   ExtractedProduct[]
  productUrls         ProductUrl[]
  crawlJobs           CrawlJob[]
}

model CrawlJob {
  id                  String          @id @default(cuid())
  sourceId            String?
  source              Source?         @relation(fields: [sourceId], references: [id])
  type                String
  status              String          @default("pending")
  progress            Int             @default(0)
  logsJson            String?
  errorsJson          String?
  payloadJson         String?
  resultJson          String?
  sourceUrl           String?
  extractedProductIds String?
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  productUrls         ProductUrl[]
  extractedProducts   ExtractedProduct[]
}

model ProductUrl {
  id          String    @id @default(cuid())
  sourceId    String?
  source      Source?   @relation(fields: [sourceId], references: [id])
  crawlJobId  String?
  crawlJob    CrawlJob? @relation(fields: [crawlJobId], references: [id])
  url         String    @unique
  status      String    @default("DISCOVERED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ExtractedProduct {
  id             String           @id @default(cuid())
  sourceId       String
  source         Source           @relation(fields: [sourceId], references: [id])
  crawlJobId     String?
  crawlJob       CrawlJob?        @relation(fields: [crawlJobId], references: [id])
  sourceUrl      String           @unique
  canonicalUrl   String?
  title          String
  normalizedJson String
  rawJson        String?
  confidence     Int
  status         String           @default("DRAFT")
  warnings       ProductWarning[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductWarning {
  id                 String           @id @default(cuid())
  extractedProductId String
  extractedProduct   ExtractedProduct @relation(fields: [extractedProductId], references: [id], onDelete: Cascade)
  code               String
  message            String
  field              String?
  createdAt          DateTime         @default(now())
}

model SourceScan {
  id                String                   @id @default(cuid())
  sourceUrl         String                   @unique
  domain            String
  brandKey          String?
  brandName         String?
  region            String?
  status            String                   @default("PENDING") // PENDING, COMPLETED, FAILED
  reportJson        String?                  // JSON of SourceCapabilityReport
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  completedAt       DateTime?
  warnings          SourceScanWarning[]
  limitProfile      SourceLimitProfile?
  capabilityReport  SourceCapabilityReport?
}

model SourceCapabilityReport {
  id           String      @id @default(cuid())
  sourceScanId String      @unique
  sourceScan   SourceScan  @relation(fields: [sourceScanId], references: [id], onDelete: Cascade)
  reportJson   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  warnings     SourceWarning[]
}

model SourceWarning {
  id                 String                  @id @default(cuid())
  sourceCapabilityReportId String
  sourceCapabilityReport SourceCapabilityReport @relation(fields: [sourceCapabilityReportId], references: [id], onDelete: Cascade)
  code               String
  message            String
  createdAt          DateTime                @default(now())
}

model SourceScanWarning {
  id           String     @id @default(cuid())
  sourceScanId String
  sourceScan   SourceScan @relation(fields: [sourceScanId], references: [id], onDelete: Cascade)
  code         String
  message      String
  createdAt    DateTime   @default(now())
}

model SourceLimitProfile {
  id                   String     @id @default(cuid())
  sourceScanId         String     @unique
  sourceScan           SourceScan @relation(fields: [sourceScanId], references: [id], onDelete: Cascade)
  maxConcurrency       Int        @default(1)
  minDelayMs           Int        @default(3000)
  maxRequestsPerMinute Int        @default(15)
  maxProductsPerRun    Int        @default(100)
  maxPagesPerRun       Int        @default(30)
  retryCount           Int        @default(3)
  timeoutMs            Int        @default(15000)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model ExtractionLog {
  id        String   @id @default(cuid())
  jobId     String?
  sourceUrl String?
  level     String   @default("info")
  message   String
  metaJson  String?
  createdAt DateTime @default(now())
}

model ImportBatch {
  id          String   @id @default(cuid())
  status      String   @default("DRAFT")
  productIds  String
  target      String   @default("shopify")
  payloadJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SourceProduct {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  url             String   @unique
  productId       String?  // ID on the supplier side
  title           String
  description     String?
  brand           String?
  currency        String
  price           Float
  raw             String?  // JSON string of full scraped data
  syncStatus      String   @default("pending") // pending, active, paused, error
  lastScrapedAt   DateTime @default(now())
  
  images          SourceImage[]
  variants        SourceVariant[]
  shopifyProduct  ShopifyProduct?
  manualReviews   ManualReviewItem[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SourceVariant {
  id              String   @id @default(cuid())
  sourceProductId String
  sourceProduct   SourceProduct @relation(fields: [sourceProductId], references: [id])
  sourceVariantId String?
  sku             String?
  color           String?
  size            String?
  price           Float?
  currency        String?
  available       Boolean  @default(true)
  stockStatus     String   @default("unknown") // in_stock, out_of_stock, low_stock, unknown
  imageUrl        String?
  raw             String?  // JSON string
  
  shopifyVariant  ShopifyVariant?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SourceImage {
  id              String   @id @default(cuid())
  sourceProductId String
  sourceProduct   SourceProduct @relation(fields: [sourceProductId], references: [id])
  url             String
  alt             String?
  color           String?
  position        Int      @default(0)
  
  createdAt       DateTime @default(now())
}

model ShopifyProduct {
  id              String   @id @default(cuid())
  sourceProductId String   @unique
  sourceProduct   SourceProduct @relation(fields: [sourceProductId], references: [id])
  shopifyId       String   @unique // GID
  handle          String?
  status          String   @default("active") // draft, active, archived
  collectionIds   String?  // Comma-separated or JSON string of collection GIDs
  price           Float?   // Summary price for display
  
  syncEnabled     Boolean  @default(true)
  syncPrice       Boolean  @default(true)
  syncInventory   Boolean  @default(true)
  syncImages      Boolean  @default(true)
  outOfStockAction String  @default("alert_only") // set_inventory_zero, draft_product, archive_product, alert_only
  
  variants        ShopifyVariant[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShopifyVariant {
  id              String   @id @default(cuid())
  shopifyProductId String
  shopifyProduct  ShopifyProduct @relation(fields: [shopifyProductId], references: [id])
  sourceVariantId String   @unique
  sourceVariant   SourceVariant @relation(fields: [sourceVariantId], references: [id])
  shopifyId       String   @unique // GID
  sku             String?
  price           Float?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PricingRule {
  id              String   @id @default(cuid())
  name            String
  supplierId      String?  // Optional override for specific supplier
  currency        String?  // "EUR", "EGP", etc.
  multiplier      Float    @default(1.0)
  fixedMarkup     Float    @default(0.0)
  percentageMarkup Float   @default(0.0)
  rounding        String   @default("none") // none, .99, .00
  minPrice        Float?
  maxPrice        Float?
  isDefault       Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncJob {
  id              String   @id @default(cuid())
  type            String   // SCRAPE, PUBLISH, SYNC_ALL, etc.
  status          String   @default("pending") // pending, running, completed, failed
  payload         String?  // JSON input
  result          String?  // JSON output or error
  startedAt       DateTime?
  completedAt     DateTime?
  
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  sourceProductId String?
  sourceProduct   SourceProduct? @relation(fields: [sourceProductId], references: [id])
  action          String
  details         String?  // JSON
  userId          String?
  
  createdAt       DateTime @default(now())
}

model ManualReviewItem {
  id              String   @id @default(cuid())
  sourceProductId String
  sourceProduct   SourceProduct @relation(fields: [sourceProductId], references: [id])
  reason          String
  status          String   @default("pending") // pending, approved, rejected
  resolvedAt      DateTime?
  
  createdAt       DateTime @default(now())
}

model ShopifyConnection {
  id              String   @id @default(uuid())
  shopDomain      String   @unique
  clientId        String
  clientSecretEnc String
  accessTokenEnc  String?
  scopes          String   @default("read_products,write_products,read_inventory,write_inventory,read_files,write_files,read_publications,write_publications")
  isConnected     Boolean  @default(false)
  connectedAt     DateTime?
  oauthState      String?
  oauthStateExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
